# Kopieer dit bestand naar .env en pas de paden/URL aan naar jouw situatie.

# Map op de host (bv. een NAS-share) met daarin db/ en data/landing/.
# Wordt gemount op /data in de pipeline- en api-container.
FINANCE_DATA_ROOT=./data-root

# Map op de host met jouw categorisatie_regels.yaml (kopieer eerst
# config/categorisatie_regels.example.yaml hiernaartoe en pas hem aan).
# Wordt gemount op /app/config in de pipeline- en api-container.
FINANCE_CONFIG_ROOT=./config

# Adres waarop de browser de API kan bereiken. Wordt ingebakken in de
# frontend-build (NEXT_PUBLIC_*-vars zijn build-time) — dus na wijzigen
# moet de frontend-image opnieuw gebouwd worden: docker compose build frontend
#
# LET OP: "localhost" werkt alleen als je de frontend op hetzelfde apparaat opent
# als waar Docker draait. Wil je 'm ook vanaf je telefoon/andere apparaten op je
# netwerk bereiken, gebruik dan het LAN-IP-adres van de machine die Docker draait
# (bv. je NAS of deze Mac), bv. http://192.168.1.140:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Komma-gescheiden lijst van origins die de API mag aanroepen (CORS). Moet
# overeenkomen met hoe je de frontend bezoekt — dus als NEXT_PUBLIC_API_BASE_URL
# hierboven een LAN-IP gebruikt, hoort hier de bijbehorende frontend-origin bij
# (poort 3000, niet 8000), bv. http://192.168.1.140:3000. Meerdere waarden mogen:
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.140:3000
CORS_ORIGINS=http://localhost:3000
